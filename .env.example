# SolarFlow API server configuration (copy to .env). Every variable is read in src/config.js.

# --- Server ---------------------------------------------------------------
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
# Set to true when running behind nginx/a load balancer so rate limits see the real client IP.
TRUST_PROXY=false
LOG_LEVEL=info
# Where state files, standards snapshots and backups are written.
DATA_DIR=./data
LOG_DIR=./logs
BODY_LIMIT=1mb

# --- Authentication ---------------------------------------------------------
# REQUIRED in production: at least 32 random characters, e.g. `openssl rand -hex 32`.
JWT_SECRET=
JWT_EXPIRES_IN=24h
JWT_ISSUER=solarflow
BCRYPT_ROUNDS=12
MAX_FAILED_LOGINS=5
LOGIN_LOCKOUT_MS=3600000

# --- Database (optional) ----------------------------------------------------
# Leave empty to run without PostgreSQL: the site, product catalogue, standards
# and shared state still work. Users, audit log and backups need a database.
DATABASE_URL=
# DATABASE_URL=postgresql://solarflow:change-me@localhost:5432/solarflow
DATABASE_SSL=false
# Only for managed databases with self-signed certificates.
DATABASE_SSL_INSECURE=false
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=5000
DATABASE_RETRY_DELAY_MS=10000
# 0 = keep retrying forever
DATABASE_MAX_RETRIES=0

# --- CORS -------------------------------------------------------------------
# Comma-separated list of allowed browser origins.
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000
# CORS_ORIGIN=https://samskiezz.github.io,https://projectsolar.cloud

# --- Rate limiting ----------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_MODIFY_MAX=100

# --- Shared front-end state (/api/state) ------------------------------------
# The static pages POST their whole state without credentials. Only enable
# anonymous writes on a private deployment.
ALLOW_ANONYMOUS_STATE_WRITES=false
STATE_MAX_BYTES=1048576

# --- Standards ----------------------------------------------------------------
# Admin-triggered refresh may fetch public sources when true; GET never does.
STANDARDS_REMOTE_FETCH=false
STANDARDS_REQUEST_TIMEOUT_MS=10000

# --- WebSocket ----------------------------------------------------------------
WS_HEARTBEAT_MS=30000
WS_MAX_PAYLOAD_BYTES=65536
SHUTDOWN_TIMEOUT_MS=10000

# --- Content Security Policy ----------------------------------------------------
# Added to connect-src so the browser may call the VPS API from pages served here.
# VPS_API_URL=https://api.projectsolar.cloud

# --- VPS persistence server (server/vps-server.js) ----------------------------
# VPS_WRITE_KEY=change-me   # clients must send X-Api-Key on POST
# STATIC_DIR=./docs
