# SolarFlow API server configuration (copy to .env). Every variable is read in src/config.js.

# --- Server ---------------------------------------------------------------
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
# Set to true when running behind nginx/a load balancer so rate limits see the real client IP.
TRUST_PROXY=false
LOG_LEVEL=info
# Where state files, standards snapshots and backups are written.
DATA_DIR=./data
LOG_DIR=./logs
BODY_LIMIT=1mb

# --- Authentication ---------------------------------------------------------
# REQUIRED in production: at least 32 random characters, e.g. `openssl rand -hex 32`.
JWT_SECRET=
JWT_EXPIRES_IN=24h
JWT_ISSUER=solarflow
BCRYPT_ROUNDS=12
MAX_FAILED_LOGINS=5
LOGIN_LOCKOUT_MS=3600000

# --- Database (optional) ----------------------------------------------------
# Leave empty to run without PostgreSQL: the site, product catalogue, standards
# and shared state still work. Users, audit log and backups need a database.
DATABASE_URL=
# DATABASE_URL=postgresql://solarflow:change-me@localhost:5432/solarflow
DATABASE_SSL=false
# Only for managed databases with self-signed certificates.
DATABASE_SSL_INSECURE=false
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=5000
DATABASE_RETRY_DELAY_MS=10000
# 0 = keep retrying forever
DATABASE_MAX_RETRIES=0

# --- CORS -------------------------------------------------------------------
# Comma-separated list of allowed browser origins.
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000
# CORS_ORIGIN=https://samskiezz.github.io,https://projectsolar.cloud

# --- Rate limiting ----------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_MODIFY_MAX=100

# --- Shared front-end state (/api/state) ------------------------------------
# The static pages POST their whole state without credentials. Only enable
# anonymous writes on a private deployment.
ALLOW_ANONYMOUS_STATE_WRITES=false
STATE_MAX_BYTES=1048576

# --- Standards ----------------------------------------------------------------
# Admin-triggered refresh may fetch public sources when true; GET never does.
STANDARDS_REMOTE_FETCH=false
STANDARDS_REQUEST_TIMEOUT_MS=10000

# --- Business connectors (read-only) ------------------------------------------
# The server pulls ServiceM8, Xero, Google Workspace and the bank feed into
# data/business/ and serves the built model at /api/business/model. Credentials
# live only here, never in the site or the game save.
# Static bearer token the game may use for /api/business/* (or log in as a user).
BUSINESS_API_TOKEN=
# Re-sync every N minutes (0 = only when an admin presses Sync).
BUSINESS_SYNC_MINUTES=0
BUSINESS_NAME=
# Comma-separated email domains that count as "us" when reading mail.
BUSINESS_DOMAINS=
BUSINESS_TIMEZONE=Australia/Sydney
# ServiceM8: a private-app API key (preferred) or account email + password.
SERVICEM8_API_KEY=
SERVICEM8_EMAIL=
SERVICEM8_PASSWORD=
SERVICEM8_MAX_JOBS=5000
# Xero custom connection (client credentials) with read-only accounting scopes.
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_TENANT_ID=
XERO_MONTHS=12
# Google Workspace: a service-account key with domain-wide delegation
# (Gmail, Drive, Calendar and Admin Directory read-only scopes), acting as
# GOOGLE_IMPERSONATE. GOOGLE_ALL_USERS=true reads every mailbox in the domain.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_IMPERSONATE=
GOOGLE_ALL_USERS=false
# ...or an OAuth refresh token for one mailbox instead of a service account.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_HANDOVER_FOLDER_ID=
GOOGLE_CALENDAR_ID=primary
GOOGLE_MAIL_QUERY=newer_than:365d -category:promotions -category:social
GOOGLE_MAIL_MAX_THREADS=2000
# Bank feed: any read-only endpoint returning {banks:[], accounts:[], transactions:[]}
# (open-banking aggregator export) plus its bearer token.
BANK_FEED_URL=
BANK_FEED_TOKEN=

# --- WebSocket ----------------------------------------------------------------
WS_HEARTBEAT_MS=30000
WS_MAX_PAYLOAD_BYTES=65536
SHUTDOWN_TIMEOUT_MS=10000

# --- Content Security Policy ----------------------------------------------------
# Added to connect-src so the browser may call the VPS API from pages served here.
# VPS_API_URL=https://api.projectsolar.cloud

# --- VPS persistence server (server/vps-server.js) ----------------------------
# VPS_WRITE_KEY=change-me   # clients must send X-Api-Key on POST
# STATIC_DIR=./docs
