{
  "name": "solarflow-minion-world-loader",
  "version": "2.7.0",
  "description": "SolarFlow solar/battery compliance platform: static GitHub Pages front end plus an optional Express/PostgreSQL API",
  "main": "server.js",
  "private": true,
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --test tests/*.test.js tests/*.test.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check": "npm run check:syntax && npm run check:json && npm run check:links",
    "check:syntax": "node scripts/check-syntax.js",
    "check:json": "node scripts/validate-json.js",
    "check:links": "node scripts/check-links.js",
    "build": "node scripts/build_all.js",
    "build:cer": "node create-realistic-cer-db.js",
    "verify": "npm run lint && npm run check && npm test",
    "docker:build": "docker build -t solarflow:latest .",
    "docker:run": "docker run --rm -p 3000:3000 --env-file .env solarflow:latest",
    "features:realm": "node scripts/realm-features.mjs",
    "smoke:realm": "node tests/browser/realm-selftest.js docs docs/realm/selftest-browser.json && node tests/browser/realm-app-smoke.js docs"
  },
  "keywords": [
    "solar",
    "battery",
    "compliance",
    "AS/NZS",
    "clean-energy",
    "australia",
    "standards"
  ],
  "author": "SolarFlow Development Team",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.12.2",
    "bcryptjs": "^2.4.3",
    "cheerio": "^1.0.0",
    "compression": "^1.7.5",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "isomorphic-dompurify": "^2.16.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "validator": "^13.12.0",
    "winston": "^3.17.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "eslint": "^9.36.0",
    "globals": "^15.15.0",
    "nodemon": "^3.1.7"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
